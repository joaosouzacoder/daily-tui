# daily-tui — variáveis de ambiente das CLIs auxiliares.
#
# Copie para o seu shell (bash/zsh: ~/.bashrc ou ~/.zshrc; fish: use `set -gx`)
# e ajuste os valores. As que têm fallback no 1Password/arquivo são opcionais.

# --- Agenda (daily-tui) ---------------------------------------------------
# E-mail da agenda primária de cada conta (filtro --calendar do gcalcli).
# Sem isso, o painel de agenda usa um placeholder e não acha seus eventos.
export DAILY_TUI_PERSONAL_EMAIL="voce@gmail.com"
export DAILY_TUI_WORK_EMAIL="voce@suaempresa.com"

# --- GitHub (ghpending) ---------------------------------------------------
# Personal Access Token com escopo `repo` (clássico) ou fine-grained de leitura.
export GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"

# --- Jira (jirapending) ---------------------------------------------------
export JIRA_EMAIL="voce@suaempresa.com"          # e-mail da conta Atlassian
export JIRA_CLOUD="suaempresa.atlassian.net"      # domínio da instância
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Se não exportar JIRA_TOKEN, o script tenta o 1Password (item "$JIRA_OP_ITEM").
export JIRA_TOKEN="seu_api_token_do_jira"
# export JIRA_OP_ITEM="Token JIRA"                # nome do item no 1Password (opcional)
# export JIRA_JQL="assignee = currentUser() AND statusCategory != Done ORDER BY project ASC, updated DESC"

# --- Google Tasks (gtasks) ------------------------------------------------
# OAuth client "Desktop app" (JSON baixado do Google Cloud Console). Defaults:
#   secret: ~/.config/daily-tui/gtasks-client-secret.json
#   token:  ~/.local/share/daily-tui/gtasks-personal.json
# export GTASKS_CLIENT_SECRET="$HOME/.config/daily-tui/gtasks-client-secret.json"
# export GTASKS_TOKEN="$HOME/.local/share/daily-tui/gtasks-personal.json"
