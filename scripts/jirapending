#!/usr/bin/env bash
# jirapending — lista os tickets do Jira atribuídos a você e ainda abertos,
# agrupados por projeto e coloridos (ANSI), para o painel do daily-tui.
#
# Configuração via variáveis de ambiente (veja scripts/daily-tui.env.example):
#   JIRA_EMAIL   — seu e-mail Atlassian              (obrigatório)
#   JIRA_CLOUD   — domínio da instância, ex.:
#                  "suaempresa.atlassian.net"        (obrigatório)
#   JIRA_TOKEN   — API token do Jira. Se ausente, cai no 1Password (item
#                  "$JIRA_OP_ITEM") — útil pra não vazar o token no shell.
#   JIRA_OP_ITEM — nome do item no 1Password         (default: "Token JIRA")
#   JIRA_JQL     — sobrescreve a query JQL padrão     (opcional)
#
# Requer: curl, jq (e op só no caminho de fallback do 1Password).
set -euo pipefail

: "${JIRA_EMAIL:?defina JIRA_EMAIL (seu e-mail Atlassian)}"
: "${JIRA_CLOUD:?defina JIRA_CLOUD (ex.: suaempresa.atlassian.net)}"
JIRA_OP_ITEM="${JIRA_OP_ITEM:-Token JIRA}"
JQL="${JIRA_JQL:-assignee = currentUser() AND statusCategory != Done ORDER BY project ASC, updated DESC}"

TOKEN="${JIRA_TOKEN:-$(op item get "$JIRA_OP_ITEM" --fields credential --reveal)}"

body=$(jq -n --arg jql "$JQL" \
  '{jql:$jql, fields:["summary","status","project"], maxResults:100}')

curl -sf -u "$JIRA_EMAIL:$TOKEN" -X POST "https://$JIRA_CLOUD/rest/api/3/search/jql" \
  -H "Content-Type: application/json" \
  -d "$body" \
| jq -r '
    .issues
    | group_by(.fields.project.key)[]
    | "[36;1m\(.[0].fields.project.key) (\(length))[0m",
      (.[] | "  [33m\(.key)[0m [90m[\(.fields.status.name)][0m \(.fields.summary)")
  '
