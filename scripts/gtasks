#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "google-api-python-client",
#   "google-auth-oauthlib",
#   "google-auth",
# ]
# ///
"""gtasks — CLI mínima para o Google Tasks (conta pessoal), usada pelo daily-tui.

Usa um client OAuth "Desktop app" do Google Cloud; guarda o token (escopo
tasks) localmente. Configuração via variáveis de ambiente:

  GTASKS_CLIENT_SECRET — JSON do OAuth client baixado do Google Cloud Console
                         (default: ~/.config/daily-tui/gtasks-client-secret.json)
  GTASKS_TOKEN         — onde salvar o token gerado
                         (default: ~/.local/share/daily-tui/gtasks-personal.json)

Subcomandos:
  gtasks auth                  # consent único (abre o navegador), salva o token
  gtasks list                  # JSON das tarefas da lista padrão
  gtasks add "<título>"
  gtasks complete <id>
  gtasks reopen <id>
  gtasks edit <id> "<título>"
  gtasks delete <id>
"""
import json
import os
import sys
from pathlib import Path

from google.auth.transport.requests import Request
from google.oauth2.credentials import Credentials
from google_auth_oauthlib.flow import InstalledAppFlow
from googleapiclient.discovery import build

SCOPES = ["https://www.googleapis.com/auth/tasks"]
CLIENT_SECRET = Path(os.environ.get(
    "GTASKS_CLIENT_SECRET",
    str(Path.home() / ".config/daily-tui/gtasks-client-secret.json")))
TOKEN = Path(os.environ.get(
    "GTASKS_TOKEN",
    str(Path.home() / ".local/share/daily-tui/gtasks-personal.json")))
TASKLIST = "@default"


def load_creds():
    creds = None
    if TOKEN.exists():
        creds = Credentials.from_authorized_user_file(str(TOKEN), SCOPES)
    if creds and creds.valid:
        return creds
    if creds and creds.expired and creds.refresh_token:
        creds.refresh(Request())
        TOKEN.write_text(creds.to_json())
        return creds
    sys.exit("sem credenciais — rode: gtasks auth")


def do_auth():
    if not CLIENT_SECRET.exists():
        sys.exit(f"client secret não encontrado: {CLIENT_SECRET}")
    flow = InstalledAppFlow.from_client_secrets_file(str(CLIENT_SECRET), SCOPES)
    creds = flow.run_local_server(port=0)
    TOKEN.parent.mkdir(parents=True, exist_ok=True)
    TOKEN.write_text(creds.to_json())
    print(f"ok — token salvo em {TOKEN}")


def service():
    return build("tasks", "v1", credentials=load_creds(), cache_discovery=False)


def do_list():
    items = (service().tasks()
             .list(tasklist=TASKLIST, showCompleted=True, showHidden=False,
                   maxResults=100)
             .execute().get("items", []))
    out = [{
        "id": t["id"],
        "title": (t.get("title") or "").strip(),
        "completed": t.get("status") == "completed",
        "due": (t.get("due") or "")[:10],
        "notes": t.get("notes") or "",
        "position": t.get("position", ""),
    } for t in items]
    out.sort(key=lambda x: (x["completed"], x["position"]))
    print(json.dumps(out, ensure_ascii=False))


def do_add(title):
    service().tasks().insert(tasklist=TASKLIST, body={"title": title}).execute()


def do_complete(tid):
    service().tasks().patch(tasklist=TASKLIST, task=tid,
                            body={"status": "completed"}).execute()


def do_reopen(tid):
    service().tasks().patch(tasklist=TASKLIST, task=tid,
                            body={"status": "needsAction", "completed": None}).execute()


def do_edit(tid, title):
    service().tasks().patch(tasklist=TASKLIST, task=tid,
                            body={"title": title}).execute()


def do_delete(tid):
    service().tasks().delete(tasklist=TASKLIST, task=tid).execute()


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit("uso: gtasks {auth|list|add|complete|reopen|edit|delete}")
    cmd, rest = args[0], args[1:]
    if cmd == "auth":
        do_auth()
    elif cmd == "list":
        do_list()
    elif cmd == "add":
        do_add(rest[0])
    elif cmd == "complete":
        do_complete(rest[0])
    elif cmd == "reopen":
        do_reopen(rest[0])
    elif cmd == "edit":
        do_edit(rest[0], rest[1])
    elif cmd == "delete":
        do_delete(rest[0])
    else:
        sys.exit(f"comando desconhecido: {cmd}")


if __name__ == "__main__":
    main()
